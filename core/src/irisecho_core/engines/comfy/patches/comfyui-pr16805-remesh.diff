+    label = torch.arange(n, device=edges.device)
+    a, b = edges[:, 0], edges[:, 1]
+    while True:
+        low = torch.minimum(label[a], label[b])
+        new = label.clone()
+        new.scatter_reduce_(0, a, low, "amin")
+        new.scatter_reduce_(0, b, low, "amin")
+        new = new[new]
+        if torch.equal(new, label):
+            return label
+        label = new
 
 
